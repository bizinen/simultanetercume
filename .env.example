# =============================================================================
# Admin Panel — Kimlik Doğrulama
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
JWT_SECRET_KEY=replace-with-random-32-char-secret-key

# =============================================================================
# Genel — Dil, Log, Gecikme
# =============================================================================
SOURCE_LANGUAGE=tr
TARGET_LANGUAGE=en
LOG_LEVEL=INFO
TARGET_LATENCY_MS=5000

# =============================================================================
# STT (Speech-to-Text) — Provider: elevenlabs | deepgram | gladia | speechmatics | gemini_live
# =============================================================================
STT_PROVIDER=elevenlabs
STT_MODEL=scribe_v2_realtime

# ElevenLabs (STT/TTS ortak API key)
ELEVENLABS_API_KEY=sk_...

# VAD (ElevenLabs STT ile kullanılır)
VAD_SILENCE_THRESHOLD=0.6
VAD_THRESHOLD=0.5
MIN_SPEECH_DURATION_MS=250
MIN_SILENCE_DURATION_MS=200

# Deepgram (STT: deepgram.com — $200 ücretsiz kredi)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_NO_DELAY=false
DEEPGRAM_UTTERANCE_END_MS=1000
DEEPGRAM_KEYWORDS=

# Gladia
GLADIA_API_KEY=
GLADIA_MODEL=solaria-1
GLADIA_ENDPOINTING=0.5
GLADIA_MAX_DURATION=5
GLADIA_AUDIO_ENHANCER=false
GLADIA_CODE_SWITCHING=false

# Speechmatics (STT — yüksek doğruluk; speechmatics.com)
SPEECHMATICS_API_KEY=
SPEECHMATICS_LANGUAGE=tr
SPEECHMATICS_PARTIALS=true
SPEECHMATICS_MAX_DELAY=1.0
SPEECHMATICS_TURN_DETECTION=external

# =============================================================================
# TTS (Text-to-Speech) — Provider: elevenlabs | deepgram
# =============================================================================
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID_MALE=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID_FEMALE=Xb7hH8MSUJpSbSDYk0k2
TTS_SPEED=0.95
TTS_STABILITY=0.75
TTS_SIMILARITY_BOOST=0.3
TTS_STYLE=0.0
TTS_USE_SPEAKER_BOOST=true
TTS_OPTIMIZE_LATENCY=4
TTS_TEXT_NORMALIZATION=auto

# Deepgram TTS
DEEPGRAM_TTS_MODEL=aura-asteria-en
DEEPGRAM_TTS_ENCODING=linear16

# =============================================================================
# LLM — Provider: openai | gemini | groq
# =============================================================================
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_MODEL=gpt-4o-mini

# OpenAI (LLM_PROVIDER=openai; fine-tuned: ft:org:name:id)
OPENAI_API_KEY=sk-...

# Google (LLM_PROVIDER=gemini | STT_PROVIDER=gemini_live — aistudio.google.com)
GOOGLE_API_KEY=
# İsteğe bağlı: Gemini Live STT için ayrı API key (yoksa GOOGLE_API_KEY kullanılır)
# GOOGLE_STT_API_KEY=
GEMINI_STT_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_STT_SILENCE_MS=400
GEMINI_STT_END_SENSITIVITY=HIGH
GEMINI_STT_START_SENSITIVITY=HIGH
GEMINI_STT_SYSTEM_INSTRUCTION=
GEMINI_STT_CONTEXT_COMPRESSION=true
GEMINI_STT_DOMAIN_VOCABULARY=
GEMINI_STT_PUNCTUATION_MODE=true

# Groq (LLM_PROVIDER=groq — console.groq.com)
GROQ_API_KEY=

# =============================================================================
# Fast Verifier LLM (STT Filtreleme/Doğrulayıcı)
# =============================================================================
VERIFIER_ENABLED=false
VERIFIER_PROVIDER=groq
VERIFIER_MODEL=llama3-8b-8192
VERIFIER_TIMEOUT=3.0
VERIFIER_PROMPT="You are a fast speech-to-text verifier. Your job is to read transcriptions and fix minor errors or drop garbage transcriptions (like background noise transcribed as 'you', 'so', 'right', 'uh'). If the text is garbage or incomplete meaningless fragment, respond exactly with 'DROP'. Otherwise, respond with 'KEEP|' followed by the corrected translation. Example: 'KEEP|This is the corrected text.'"

# =============================================================================
# Ses — AIC Filter, örnekleme, debug
# =============================================================================
AUDIO_SAMPLE_RATE=16000
AUDIO_OUTPUT_SAMPLE_RATE=24000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE_MS=100

AIC_ENABLED=true
AIC_GAIN_COMPENSATION=true
AIC_LICENSE_KEY=
AIC_MODEL_ID=quail-vf-l-16khz

DEBUG_AUDIO=false

# =============================================================================
# Buffer — Çeviri giriş buffer (STT → LLM)
# =============================================================================
BUFFER_FLUSH_TIMEOUT=3.0
BUFFER_MIN_WORDS_LONG=7
BUFFER_MIN_WORDS_PUNCT=5
BUFFER_MIN_SENTENCES=2
BUFFER_MIN_WORDS_TIMEOUT=4
BUFFER_MAX_WORDS=30

# =============================================================================
# Daily.co — WebRTC (Pipecat DailyTransport)
# =============================================================================
DAILY_API_KEY=

# =============================================================================
# Güvenlik — CORS
# =============================================================================
CORS_ORIGINS=*
